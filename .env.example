# Copy this file to .env for a local run.
# On Hugging Face Spaces, put secrets in Space Secrets and the rest in Variables.

# Required. Header for API routes: x-api-key: <this value>
API_KEY=change-this-to-a-long-secret-key

# Optional
ALLOWED_ORIGINS=*
MODEL_DIR=models
BUSINESS_NAME=Our Restaurant
TEMPLATES_FILE=data/templates.json
AUTO_SEND=false
AUTO_SEND_LABELS=positive
DEFAULT_COUPON=THANKYOU10
REVIEW_LINK=
BUSINESS_PHONE=

# Optional SMTP. Leave unset on Hugging Face Spaces: outbound ports 25, 465
# and 587 are blocked there, so sending mail will time out. The API still works
# without SMTP. The public demo never sends email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
